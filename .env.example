# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (keep the trailing ?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/campuscoin

# Session secret — any long random string, do not commit the real one
SESSION_SECRET=change-me-to-a-long-random-string

# Where the app runs (for reset links built into emails)
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# ---- Email (password reset, report sharing) ----
# dev: messages are printed to the server console
# prod: fill the SMTP fields of your provider
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@campuscoin.test

# ---- Extras ----
# Idle session timeout in minutes (default 30)
SESSION_IDLE_MINUTES=30
