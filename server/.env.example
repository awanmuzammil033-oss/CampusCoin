# Copy this file to `.env` and fill in the values.

# --- database ---------------------------------------------------------------
# MongoDB connection string (Atlas or a local mongod).
# Leave empty to run against an in-memory database:  $env:SEED='1'; npm run dev:local
MONGODB_URI=

# --- session ----------------------------------------------------------------
# Long random string used to sign the session cookie.
SESSION_SECRET=campuscoin-change-me-to-a-long-random-string

# --- urls -------------------------------------------------------------------
PORT=5000
APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# --- e-mail -----------------------------------------------------------------
# console  = print the message to the server terminal (development default)
# smtp     = send through SMTP (fill the four fields below)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus Coin <no-reply@campuscoin.test>

# --- optional narrative endpoint -------------------------------------------
# When set, monthly insight summaries and the top tip may be written by this
# endpoint (aggregated figures only — never descriptions or personal data).
# Without it, hand-written templates over the same figures are used.
NARRATIVE_API_URL=
NARRATIVE_API_KEY=
